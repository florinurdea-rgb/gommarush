# GoRush Print Agent — copy to .env and fill in.
# This file lives on the WINDOWS machine that is already connected to the
# Toshiba printer. Never commit the real .env.

# --- Supabase ---
# Project URL (same as the web app).
SUPABASE_URL=https://sfvaqextratpnprcamwd.supabase.co

# Service-role key. This machine is trusted; a browser is not.
# NEVER put this key in the web app's NEXT_PUBLIC_* variables.
# Supabase dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Printer ---
# The EXACT Windows printer queue name. Run `npm run check-printers` to list
# them, or see the README for the PowerShell one-liner.
PRINTER_NAME=

# How the agent talks to Windows:
#   windows  print via PRINT_COMMAND (real printing)
#   file     render to ./output and never print (safe test mode)
PRINTER_ADAPTER=file

# Command used to print one PDF. {{file}} and {{printer}} are substituted.
# Default targets SumatraPDF, which is the most reliable silent PDF printer on
# Windows. Install it (https://www.sumatrapdfreader.org) or point this at
# whatever your setup uses.
# PRINT_COMMAND=SumatraPDF.exe -print-to "{{printer}}" -silent -print-settings "fit" "{{file}}"

# --- Label geometry (millimetres) ---
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=70
LABEL_MARGIN_MM=4

# --- Polling ---
POLL_INTERVAL_MS=3000
# Re-queue jobs an agent claimed but never finished (crash recovery).
STALE_JOB_MINUTES=5

# Identifies this machine in print_jobs.claimed_by. Defaults to the hostname.
# AGENT_ID=warehouse-pc-1

# Where 'file' adapter output goes.
OUTPUT_DIR=./output
