# Copy this file to .env.local for local development and fill in real
# values. .env.local is gitignored — never commit real secrets.
#
# The same variables also need to be added in Vercel: Project Settings →
# Environment Variables → set for Production, Preview, and Development.
# See README.md for exactly where to find each value.

# ============================================================================
# Supabase — REQUIRED
# ============================================================================
# Project URL and anon key are both safe to expose to the browser (that's
# what NEXT_PUBLIC_ means).
NEXT_PUBLIC_SUPABASE_URL=https://sfvaqextratpnprcamwd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNmdmFxZXh0cmF0cG5wcmNhbXdkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NTQ0MjQsImV4cCI6MjEwMTQzMDQyNH0.Gnedt0tWDp6A7KcktO0S4kIRI2oIrvJ-sBIBIdaopHo

# Service-role key. NEVER prefix this with NEXT_PUBLIC_.
#
# THE LOGISTICS APP DOES NOT WORK WITHOUT THIS. Row Level Security is enabled
# on every logistics table with no policies, so the anon key cannot read or
# write any of them — by design. All access goes through server-side code
# using this key.
#
# Supabase dashboard → Project Settings → API → the `service_role` `secret` key.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# App URL — REQUIRED IN PRODUCTION
# ============================================================================
# Used to build the PERMANENT stand QR targets (https://…/stand/A) and the unit
# QR fallback links. Set this explicitly: the stand stickers are physical, so
# they must keep pointing at the right host even when Vercel gives a deployment
# its own generated URL. Falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=

# ============================================================================
# Admin session — REQUIRED IN PRODUCTION
# ============================================================================
# HMAC key for signing the admin/driver session cookies. Any random string of
# 32+ characters:  openssl rand -hex 32
# Without it, a random per-instance key is used and sessions do not survive a
# redeploy (annoying, never insecure).
ADMIN_SESSION_SECRET=

# Phase 1 development credentials. Defaults are test / test when unset.
# These are DEVELOPMENT AUTH ONLY — see README "Security notes".
ADMIN_USERNAME=test
ADMIN_PASSWORD=test

# Optional: separate signing key for the driver session. Falls back to
# ADMIN_SESSION_SECRET.
DRIVER_SESSION_SECRET=

# ============================================================================
# Document analysis (AI/OCR) — OPTIONAL
# ============================================================================
# When unset, document upload still works: the original is stored, a text layer
# is read where one exists, and the review screen shows
# "Analiza automată nu este configurată" with a manual form.
# Nothing is ever fabricated.
#
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# ============================================================================
# Resend (existing offer-request feature) — OPTIONAL
# ============================================================================
# Server-only. Never expose to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GommaRush <offerte@gommarush.com>
OFFER_NOTIFICATION_EMAIL=vendite@gommarush.com
