# Copy this file to .env.local for local development and fill in real
# values. .env.local is gitignored — never commit real secrets.
#
# The same variables also need to be added in Vercel: Project Settings →
# Environment Variables → set for Production, Preview, and Development.
# See README.md for exactly where to find each value.

# ============================================================================
# Supabase — REQUIRED
# ============================================================================
# Project URL and public key are both safe to expose to the browser (that's
# what NEXT_PUBLIC_ means) — they only allow what Row Level Security allows,
# which for the logistics tables is nothing (see SUPABASE_SERVICE_ROLE_KEY
# below).
NEXT_PUBLIC_SUPABASE_URL=https://sfvaqextratpnprcamwd.supabase.co

# Supabase is migrating from "anon key" to "publishable key" naming for the
# same public role. Set whichever your project's API settings page shows —
# the app prefers PUBLISHABLE_KEY and falls back to ANON_KEY automatically,
# so only one of these two needs a value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNmdmFxZXh0cmF0cG5wcmNhbXdkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NTQ0MjQsImV4cCI6MjEwMTQzMDQyNH0.Gnedt0tWDp6A7KcktO0S4kIRI2oIrvJ-sBIBIdaopHo

# Service-role key. NEVER prefix this with NEXT_PUBLIC_.
#
# THE LOGISTICS APP DOES NOT WORK WITHOUT THIS. Row Level Security is enabled
# on every logistics table with no policies, so the anon key cannot read or
# write any of them — by design. All access goes through server-side code
# using this key.
#
# Supabase dashboard → Project Settings → API → the `service_role` `secret` key.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Admin authorization — OPTIONAL, recommended once real operators exist
# ============================================================================
# Comma-separated list of emails allowed to use the admin panel. Any
# confirmed Supabase Auth user can sign in (authentication), but only these
# addresses are treated as admins (authorization) — everyone else gets 403,
# not "wrong password". Leave unset to allow any confirmed Supabase user,
# which is the original Phase 1 single-admin-tier default.
ADMIN_ALLOWED_EMAILS=

# Admin login brute-force protection. Only failed attempts count against
# this — a successful login resets it, so a real admin is never locked out
# by normal use. Both optional; shown here with their defaults.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ============================================================================
# App URL — REQUIRED IN PRODUCTION
# ============================================================================
# Used to build the unit QR fallback links (https://…/u/TOKEN) printed on unit
# labels. Set this explicitly in production so the links keep pointing at the
# right host even when Vercel gives a deployment its own generated URL. Falls
# back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=

# ============================================================================
# Document analysis (AI/OCR) — OPTIONAL
# ============================================================================
# When unset, document upload still works: the original is stored, a text layer
# is read where one exists, and the review screen shows
# "Analiza automată nu este configurată" with a manual form.
# Nothing is ever fabricated.
#
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# The DDT/invoice import pipeline (app/admin/orders/import) additionally
# supports OpenAI as an alternative provider, tried when
# ANTHROPIC_API_KEY isn't set — useful if that's the key you already have.
# platform.openai.com → API Keys
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-4.1.
OPENAI_MODEL=


# ============================================================================
# Resend (existing offer-request feature) — OPTIONAL
# ============================================================================
# Server-only. Never expose to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GommaRush <offerte@gommarush.com>
OFFER_NOTIFICATION_EMAIL=vendite@gommarush.com

# The quote-request flow (/richiedi-offerta) reuses the same Resend account.
# Both of these are OPTIONAL OVERRIDES: when unset it falls back to
# RESEND_FROM_EMAIL and OFFER_NOTIFICATION_EMAIL above, so an existing
# deployment needs no new mail configuration at all. Set them only if the
# quote notifications should go somewhere different from the older
# offer-request notifications.
EMAIL_FROM=
SALES_NOTIFICATION_EMAIL=

# --- Inter-Sprint / Inter-Tyre Gateway ---------------------------------------
# Live HTTP gateway (stock, order validation, ordering, delivery notes,
# invoices). Separate from the FTP catalogue feed.
#
# Inter-Sprint and Inter-Tyre logins are NOT interchangeable (Manual v2.2
# §1.1), so each partner has its own complete set.
#
# The customer number is a URL parameter (`kl`), not part of authentication.
# Authentication is HTTP Basic (§1.4).
#
# INTERSPRINT_GATEWAY_ENV: "test" or "production". Anything else resolves to
# "test" — guessing wrong must never mean talking to production.
INTERSPRINT_GATEWAY_ENV=test
INTERSPRINT_GATEWAY_CUSTOMER_NUMBER=
INTERSPRINT_GATEWAY_USERNAME=
INTERSPRINT_GATEWAY_PASSWORD=
# Optional. Defaults to the URL documented in §1.1 for the selected
# environment. Override only to move to HTTPS or a relocated host.
INTERSPRINT_GATEWAY_BASE_URL=
INTERSPRINT_GATEWAY_TIMEOUT_MS=20000
# Only the exact string "true" enables real ordering. Anything else — unset,
# empty, misspelled — leaves it off. Protocol 104 without test=1 is refused
# before any network call while this is false.
INTERSPRINT_LIVE_ORDERING_ENABLED=false

INTERTYRE_GATEWAY_ENV=test
INTERTYRE_GATEWAY_CUSTOMER_NUMBER=
INTERTYRE_GATEWAY_USERNAME=
INTERTYRE_GATEWAY_PASSWORD=
INTERTYRE_GATEWAY_BASE_URL=
INTERTYRE_GATEWAY_TIMEOUT_MS=20000
INTERTYRE_LIVE_ORDERING_ENABLED=false

# ============================================================================
# Scheduled document analysis worker — REQUIRED IN PRODUCTION
# ============================================================================
# /api/cron/document-analysis mutates data and calls a paid AI provider, so it
# refuses every request unless this is set and matches the caller's
# `Authorization: Bearer $CRON_SECRET` header. Unset means the worker refuses
# everything — it fails closed rather than defaulting open.
#
# Set it in Vercel and use the same value in the Vercel Cron configuration.
CRON_SECRET=

# ============================================================================
# Inter-Sprint live probe — DIAGNOSTIC ONLY, never set in production
# ============================================================================
# Gates tests/intersprint-live-probe.test.ts, which talks to the REAL supplier
# gateway. Read-only: protocol 104 (order entry) has no code path there, not
# even its test=1 validation mode. Unset means the probe skips, so `npm test`
# and CI are unaffected.
#
#   INTERSPRINT_LIVE_PROBE=1 npx vitest run tests/intersprint-live-probe.test.ts
INTERSPRINT_LIVE_PROBE=

# ============================================================================
# Deldo NV API — OPTIONAL until the lane goes live
# ============================================================================
# Server-side only. The token is a bearer credential carried as a URL query
# parameter, so HTTPS is enforced in code and a plain-http base URL is refused.
#
# "test" or "live". Anything unrecognised resolves to "test" — guessing wrong
# must never mean talking to the live environment. The test environment serves
# the same fictional data as 26933TEST.csv, so every observation it returns is
# recorded as test data and can never be used commercially.
DELDO_API_ENVIRONMENT=test

# Request from Jan@deldo.com. Never commit a real value.
DELDO_API_TOKEN=

# Optional for the test environment, which defaults to the documented URL
# https://api-test.deldo.be/gaston/dotcube_cgi
#
# REQUIRED for "live": Deldo supplies the live URL only after the testing
# procedure completes, so there is no default and none will be invented.
DELDO_API_BASE_URL=
DELDO_API_TIMEOUT_MS=15000
