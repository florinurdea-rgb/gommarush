# Copy this file to .env.local for local development and fill in real
# values. .env.local is gitignored — never commit real secrets.
#
# The same variables also need to be added in Vercel: Project Settings →
# Environment Variables → set for Production, Preview, and Development.
# See README.md for exactly where to find each value.

# ============================================================================
# Supabase — REQUIRED
# ============================================================================
# Project URL and public key are both safe to expose to the browser (that's
# what NEXT_PUBLIC_ means) — they only allow what Row Level Security allows,
# which for the logistics tables is nothing (see SUPABASE_SERVICE_ROLE_KEY
# below).
NEXT_PUBLIC_SUPABASE_URL=https://sfvaqextratpnprcamwd.supabase.co

# Supabase is migrating from "anon key" to "publishable key" naming for the
# same public role. Set whichever your project's API settings page shows —
# the app prefers PUBLISHABLE_KEY and falls back to ANON_KEY automatically,
# so only one of these two needs a value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNmdmFxZXh0cmF0cG5wcmNhbXdkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NTQ0MjQsImV4cCI6MjEwMTQzMDQyNH0.Gnedt0tWDp6A7KcktO0S4kIRI2oIrvJ-sBIBIdaopHo

# Service-role key. NEVER prefix this with NEXT_PUBLIC_.
#
# THE LOGISTICS APP DOES NOT WORK WITHOUT THIS. Row Level Security is enabled
# on every logistics table with no policies, so the anon key cannot read or
# write any of them — by design. All access goes through server-side code
# using this key.
#
# Supabase dashboard → Project Settings → API → the `service_role` `secret` key.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Admin authorization — OPTIONAL, recommended once real operators exist
# ============================================================================
# Comma-separated list of emails allowed to use the admin panel. Any
# confirmed Supabase Auth user can sign in (authentication), but only these
# addresses are treated as admins (authorization) — everyone else gets 403,
# not "wrong password". Leave unset to allow any confirmed Supabase user,
# which is the original Phase 1 single-admin-tier default.
ADMIN_ALLOWED_EMAILS=

# Admin login brute-force protection. Only failed attempts count against
# this — a successful login resets it, so a real admin is never locked out
# by normal use. Both optional; shown here with their defaults.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ============================================================================
# App URL — REQUIRED IN PRODUCTION
# ============================================================================
# Used to build the PERMANENT stand QR targets (https://…/stand/A) and the unit
# QR fallback links. Set this explicitly: the stand stickers are physical, so
# they must keep pointing at the right host even when Vercel gives a deployment
# its own generated URL. Falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=

# ============================================================================
# Driver session — REQUIRED IN PRODUCTION
# ============================================================================
# Admin login no longer uses this (it's Supabase Auth now — see above). This
# HMAC key is only for the /driver session cookie, which stays a simple
# self-selected identity by Phase 1 design (see driver-session.ts). Any
# random string of 32+ characters:  openssl rand -hex 32
# Without it, a random per-instance key is used and driver sessions do not
# survive a redeploy (annoying, never insecure).
ADMIN_SESSION_SECRET=

# Optional: separate signing key for the driver session. Falls back to
# ADMIN_SESSION_SECRET above.
DRIVER_SESSION_SECRET=

# ============================================================================
# Document analysis (AI/OCR) — OPTIONAL
# ============================================================================
# When unset, document upload still works: the original is stored, a text layer
# is read where one exists, and the review screen shows
# "Analiza automată nu este configurată" with a manual form.
# Nothing is ever fabricated.
#
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# ============================================================================
# "Caută cauciuc" barcode lookup — OPTIONAL
# ============================================================================
# Shares ANTHROPIC_API_KEY / ANTHROPIC_MODEL above (uses the Messages API's
# web search tool). When unset, /cauta-cauciuc still loads; every scan
# returns "căutare indisponibilă" instead of a result.
#
# This endpoint is public (no login — see app/api/tyre-lookup), so its rate
# limit is its main cost/abuse guard. Both optional; shown with defaults.
BARCODE_LOOKUP_RATE_LIMIT_MAX_REQUESTS=60
BARCODE_LOOKUP_RATE_LIMIT_WINDOW_MINUTES=10

# ============================================================================
# Resend (existing offer-request feature) — OPTIONAL
# ============================================================================
# Server-only. Never expose to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GommaRush <offerte@gommarush.com>
OFFER_NOTIFICATION_EMAIL=vendite@gommarush.com
